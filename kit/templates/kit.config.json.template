{

  "profile": "full",
  "probes": { "evidenceRow": true },
  "coldStart": {
    "files": ["CLAUDE.md", "WORKSPACE-NOTES.md", "docs/README.md"],
    "limitBytes": 32768,
    "forceArchiveMarginBytes": 2048
  },
  "capacityTiers": {
    "default": "readyThrough",
    "tiersByDir": { "evidence/": "onDemand", "docs/": "onDemand", "archive/": "drawer", "session-notes/": "onDemand" },
    "readyThrough": { "limitBytes": 51200, "warnBytes": 40960 },
    "onDemand": { "limitBytes": 102400 },
    "indexList": { "limitBytes": 153600 },
    "drawer": { "limitBytes": null },
    "capBytes": 153600,
    "maxLines": 2000,
    "maxLineChars": 2000
  },
  "sectionRead": { "thresholdBytes": 51200, "marker": "按节读" },
  "quotas": { "l0MaxEntries": 40, "inboxMaxEntries": 50 },
  "perVolumeLimitBytes": 20480,
  "baseline": { "path": ".kit-baseline.json" },
  "pathRoots": [],
  "idPrefixes": { "principle": "P-", "antiPattern": "A-", "evidence": "E-", "adr": "ADR-" }
}
